{
  "name": "local-reconciliation-api",

  "dockerComposeFile": "docker-compose.yml",

  "service": "devcontainer",

  "runServices": [
    "devcontainer",
    "opensearch"
  ],

  "workspaceFolder": "/workspace",

  "shutdownAction": "stopCompose",

  "postCreateCommand": "pip install --upgrade pip && pip install -r requirements-dev.txt",

  // "postStartCommand": "python scripts/bootstrap_gnd.py --auto",

  "postStartCommand": "bash scripts/start_dev_services.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml",
        "humao.rest-client"
      ]
    }
  },

  "remoteUser": "vscode"
}