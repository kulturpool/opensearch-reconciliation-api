# =============================================================================
# Environment Configuration Template
# =============================================================================
#
# This file is a TEMPLATE for environment variables.
# Copy this file to .env and adjust values as needed:
#
#   cp .env.example .env
#
# The .env file is in .gitignore and should NOT be committed to git.
# This .env.example file SHOULD be committed to show required variables.
#
# =============================================================================

# =============================================================================
# API Configuration
# =============================================================================

API_PORT=8083
HOST_API_PORT=8083
PUBLIC_BASE_URL=http://localhost:8083

# Wird im Service-Manifest als `serviceVersion` ausgeliefert (Version dieser
# Software, nicht der unterstuetzten Reconciliation-API-Version).
SERVICE_VERSION=0.1.0

# Maximale Anzahl Reconciliation-Queries pro Batch (`batchSize` im Manifest).
# Groessere Batches werden mit HTTP 413 abgelehnt.
RECONCILIATION_BATCH_SIZE=50

# Optionale URL eines quadratischen Logos fuer das Service-Manifest.
# Leer lassen, wenn kein Logo vorhanden ist.
SERVICE_LOGO_URL=

# =============================================================================
# OpenSearch Configuration
# =============================================================================

OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200

# =============================================================================
# GND Index Configuration
# =============================================================================

GND_INDEX_NAME=gnd
GND_FORCE_REINDEX=false
GND_INDEX_ENTITYFACTS=true

# Optional. Leave empty to enrich all EntityFacts-supported types.
# Example: Family
GND_ENTITYFACTS_ONLY_TYPE=

# =============================================================================
# Data Paths
# =============================================================================

GND_DATA_DIR=data

# =============================================================================
# Index Build State Configuration
# =============================================================================

# Stale lock timeout in seconds (default: 12 hours)
GND_INDEX_LOCK_STALE_SECONDS=43200

# =============================================================================
# Update Scheduler Configuration
# =============================================================================

GND_AUTO_UPDATE=true
GND_UPDATE_INTERVAL_HOURS=168
GND_UPDATE_INITIAL_DELAY_SECONDS=300
GND_UPDATE_MODE=oai

# Stale update lock timeout in seconds (default: 6 hours).
# If a previous update crashed/was killed while holding the lock, the
# scheduler will remove it and retry once it is older than this.
GND_UPDATE_LOCK_STALE_SECONDS=21600

# =============================================================================
# OAI-PMH Harvesting Configuration
# =============================================================================

GND_OAI_BASE_URL=https://services.dnb.de/oai/repository
GND_OAI_SET=authorities
GND_OAI_METADATA_PREFIX=RDFxml
GND_OAI_OVERLAP_MINUTES=60

# OAI Request timeouts and retries
GND_OAI_REQUEST_TIMEOUT_SECONDS=300
GND_OAI_REQUEST_MAX_RETRIES=6
GND_OAI_REQUEST_BACKOFF_SECONDS=10
GND_OAI_PAGE_DELAY_SECONDS=2

# =============================================================================
# GND Record Upsert Configuration
# =============================================================================

GND_RECORD_JSONLD_URL_TEMPLATE=https://d-nb.info/gnd/{id}/about/lds.jsonld

# Request delays and retries for individual record fetching
GND_UPSERT_REQUEST_DELAY_SECONDS=0.25
GND_UPSERT_REQUEST_MAX_RETRIES=5
GND_UPSERT_REQUEST_BACKOFF_SECONDS=2
GND_UPSERT_FAILED_IDS_FILE=data/state/oai_failed_ids.jsonl

# =============================================================================
# Getty Vocabulary Program (AAT) Configuration
# =============================================================================
# Getty's Art & Architecture Thesaurus is reconciled at the /getty prefix.
# It has no incremental update source (unlike GND's OAI-PMH harvest): any
# "update" is a full re-download + reindex of the explicit N-Triples export,
# switched in atomically via an OpenSearch alias (zero downtime).
# Disk space: ~1.6GB raw N-Triples + ~0.5GB OpenSearch index for AAT alone.

GETTY_INDEX_NAME=getty

# Comma-separated Getty vocabularies exposed through /getty.
# Supported: aat, ulan, tgn.
GETTY_VOCABULARIES=aat,ulan,tgn

GETTY_FORCE_REINDEX=false

GETTY_AUTO_UPDATE=true

# How often to fully rebuild the Getty index. Default: 336h (14 days).
GETTY_UPDATE_INTERVAL_HOURS=336

# Delay before the first scheduled Getty rebuild attempt after container
# startup, so it doesn't compete with the initial GND bootstrap for CPU/IO.
GETTY_UPDATE_INITIAL_DELAY_SECONDS=600

# Stale lock timeout in seconds (default: 12 hours) for the index build lock.
GETTY_INDEX_LOCK_STALE_SECONDS=43200

# Stale lock timeout in seconds (default: 6 hours) for the update-cycle lock.
GETTY_UPDATE_LOCK_STALE_SECONDS=21600

# Directory Getty's raw N-Triples exports are downloaded/extracted into.
GETTY_RAW_DIR=data/raw/getty

# URL template for Getty's explicit N-Triples export zip. {vocab} is
# substituted with each entry from GETTY_VOCABULARIES (e.g. "aat").
GETTY_DOWNLOAD_URL_TEMPLATE=http://{vocab}downloads.getty.edu/VocabData/explicit.zip

