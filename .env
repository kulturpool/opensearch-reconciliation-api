# GND Import

GND_FORCE_REINDEX=false
GND_DATA_DIR=/workspace/data

GND_DOWNLOAD_URL=

# API
API_PORT=8083
HOST_API_PORT=8083
PUBLIC_BASE_URL=http://localhost:8083

# OpenSearch
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
GND_INDEX_NAME=gnd

# Bootstrap
GND_AUTO_BOOTSTRAP=true

# Updates

AUTO_UPDATE=true

UPDATE_INTERVAL_DAYS=7

GND_FORCE_REINDEX=false
GND_INDEX_ENTITYFACTS=true
GND_ENTITYFACTS_ONLY_TYPE=

# Daily incremental update scheduler
GND_AUTO_UPDATE=true

# Run once per day
GND_UPDATE_INTERVAL_HOURS=24

# Optional first delay after container start
GND_UPDATE_INITIAL_DELAY_SECONDS=300

# OAI update mode
GND_UPDATE_MODE=oai

# Safety: do not run updates concurrently
GND_UPDATE_LOCK_ENABLED=true

# DNB OAI-PMH
GND_OAI_BASE_URL=https://services.dnb.de/oai/repository

GND_OAI_METADATA_PREFIX=RDFxml

# Individual record JSON-LD lookup
GND_RECORD_JSONLD_URL_TEMPLATE=https://d-nb.info/gnd/{id}/about/lds.jsonld

# Optional overlap to avoid missing updates around scheduler/runtime boundaries
GND_OAI_OVERLAP_MINUTES=60

GND_OAI_SET=authorities

GND_OAI_REQUEST_MAX_RETRIES=6
GND_OAI_REQUEST_BACKOFF_SECONDS=10
GND_OAI_PAGE_DELAY_SECONDS=2

